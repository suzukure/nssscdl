@startuml
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Lesson Reservation System - C4 Level 2 Container Diagram

Person(student, "Student", "Books and cancels private lessons and checks current reservation state.")
Person(admin, "School Administrator", "Manages schedules, students, exceptions, cancellations, and operational support.")
Person(operator, "System Maintainer", "Runs isolated restore validation and controlled production cutover.")

System_Boundary(system, "Lesson Reservation System") {
    Container(app, "Application Worker", "Cloudflare Workers", "Single deployment unit for Web UI, HTTP API, authentication/session handling, booking/cancellation, schedule/admin functions, notification orchestration, and scheduled handlers.")
    ContainerDb(db, "Main Database", "Cloudflare D1", "Authoritative transactional business state, including students, schedules, reservations, notification state, holiday master, role-scoped accounts, opaque server-side sessions, auth challenges, and audit data.")
    ContainerDb(recovery_db, "Recovery Database", "Cloudflare D1", "Isolated long-term artifact import and validation before controlled production cutover.")
    Container(backup_job, "Backup Operations", "Cloudflare Workflow / Scheduled component", "Dedicated D1 export, artifact validation, retention, and monitoring; separated from public request credentials.")
    Container(backup, "Backup Storage", "Cloudflare R2", "Full D1 export artifacts, manifests, and recovery metadata retained separately from the production transactional store.")
}

System_Ext(google, "Google Authentication", "External authentication provider for Google sign-in.")
System_Ext(resend, "Resend", "Outbound email delivery and delivery/failure callbacks.")
System_Ext(turnstile, "Cloudflare Turnstile", "Bot-abuse mitigation for public authentication entry points.")

note right of app
  Logical container topology per environment.
  Production and Persistent Test use separate instances of
  Worker, D1, R2, Backup Operations, credentials, and routes
  wherever those resources are present.
  Preview is isolated; Recovery is a separate temporary boundary.
end note

Rel(student, app, "Uses", "HTTPS")
Rel(admin, app, "Uses", "HTTPS")
Rel(operator, db, "Uses Time Travel for short-term recovery", "Operational access")
Rel(operator, backup, "Selects validated long-term artifact", "Operational access")
Rel(operator, recovery_db, "Imports, validates, and prepares cutover", "Operational access")
Rel(app, db, "Reads and writes authoritative business state", "D1 binding")
Rel(backup_job, db, "Exports consistent recovery artifacts", "D1 operational access")
Rel(backup_job, backup, "Stores artifacts, manifests, and recovery metadata", "R2 operational access")
Rel(app, google, "Authenticates users", "HTTPS/OAuth")
Rel(app, resend, "Sends email / receives callbacks", "HTTPS")
Rel(app, turnstile, "Verifies bot-mitigation tokens", "HTTPS")

SHOW_LEGEND()
@enduml
